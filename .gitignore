# Build directories and outputs
build/
dist/
cache/
*.apk
*.dex
*.class

# Tools & caches
tools/android.jar
tools/r8.jar
tools/debug.keystore
vendor/*
!vendor/native/
env/packages/arm/
env/packages/aarch64/

# Archives and binaries
*.tar
*.tar.gz
*.tar.zst
*.tzst
*.tar.xz
app/src/main/jniLibs/
*.bin
*.idsig

# Per-ABI Termux userspaces are BUILT, not committed (env/build.sh bootstrap).
# Committing them shipped a stale agnostic/arm tarball with no node, which made
# installs fail. CI rebuilds all four ABIs from pinned inputs.
env/dist/
env/bootstrap/*.tar.gz
env/bootstrap/*.zip
env/*-packages/
env/packages/*.deb
!env/packages/.gitkeep

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Temporary and log files
*.log
*.tmp
temp/
standalone_runtime/

# IDE and OS
.DS_Store
*.swp
*~
.idea/
.vscode/
