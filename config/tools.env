# Signing identities. Used by modules/builder/08_sign.sh for signing APKs.
DEV_KEYSTORE="${AGY_DEV_KEYSTORE:-$PROJECT_ROOT/tools/release.keystore}"
DEV_KEY_ALIAS="${AGY_DEV_KEY_ALIAS:-salman2005}"
DEV_KEY_PASS="${AGY_DEV_KEY_PASS:-salman2005}"
DEV_STORE_PASS="${AGY_DEV_STORE_PASS:-salman2005}"

# Release signing inputs
KEYSTORE="${AGY_RELEASE_KEYSTORE:-$PROJECT_ROOT/tools/release.keystore}"
KEY_ALIAS="${AGY_RELEASE_KEY_ALIAS:-salman2005}"
KEY_PASS="${AGY_RELEASE_KEY_PASS:-salman2005}"
STORE_PASS="${AGY_RELEASE_STORE_PASS:-salman2005}"
